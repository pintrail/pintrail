# Copy to .env for local development: cp .env.example .env
#
# Port 5433, not 5432, so this stack can run alongside the legacy pintrail/
# compose stack without a port collision during the migration.
DATABASE_URL=postgres://pintrail:pintrail@localhost:5433/pintrail

BIND_ADDR=0.0.0.0:8080
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5

# Set Secure on session cookies. Must stay true anywhere but local http.
COOKIE_SECURE=false

# Base URL used to build links in outbound email. Configuration rather than
# derived from the request: the Host header is attacker-controlled.
PUBLIC_BASE_URL=http://localhost:8080

# Mailer: "log" writes messages to the log instead of sending them.
# A real provider is required before launch.
MAILER=log

RUST_LOG=pintrail_api=debug,pintrail_worker=debug,tower_http=debug,info

WORKER_POLL_INTERVAL_SECS=5

# Object storage (MinIO locally, S3/R2 in production). Used from stage 6.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pintrail-media
S3_ACCESS_KEY_ID=pintrail
S3_SECRET_ACCESS_KEY=pintrail-dev-secret

# How long presigned upload/download URLs stay valid.
PRESIGN_TTL_SECS=900

# Enforced at completion; a presigned PUT cannot reject an oversized body
# while it streams. Default 100 MiB.
MAX_UPLOAD_BYTES=104857600
