# Copy to .env for local development: cp .env.example .env
#
# Port 5433, not 5432, so this stack can run alongside the legacy pintrail/
# compose stack without a port collision during the migration.
DATABASE_URL=postgres://pintrail:pintrail@localhost:5433/pintrail

BIND_ADDR=0.0.0.0:8080
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5

# Set Secure on session cookies. Must stay true anywhere but local http.
COOKIE_SECURE=false

# Base URL used to build links in outbound email. Configuration rather than
# derived from the request: the Host header is attacker-controlled.
PUBLIC_BASE_URL=http://localhost:8080

# Mailer: "log" writes messages to the log instead of sending them.
# A real provider is required before launch.
MAILER=log
# To send real email, set MAILER=smtp and the SMTP_* vars below. One SMTP impl
# works with Resend, Brevo, Amazon SES, a campus relay -- anything speaking
# SMTP. For local testing, `docker compose --profile mail up mailpit` runs a
# catcher on :1025 with a web UI at http://localhost:8025, then use:
#   MAILER=smtp SMTP_HOST=localhost SMTP_PORT=1025 SMTP_TLS=none
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_TLS=starttls          # starttls (587) | implicit (465) | none (catcher only)
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_your_api_key
# MAIL_FROM=Pintrail <no-reply@your-verified-domain>

# Trust X-Forwarded-For for rate-limit keying. Must be true behind Caddy, and
# must stay false if the API is ever reachable directly -- the header is
# forgeable. See backend/README.md.
TRUST_PROXY_HEADERS=false

RUST_LOG=pintrail_api=debug,pintrail_worker=debug,tower_http=debug,info

WORKER_POLL_INTERVAL_SECS=5

# Object storage (MinIO locally, S3/R2 in production). Used from stage 6.
S3_ENDPOINT=http://localhost:9000
# Endpoint baked into presigned URLs. Only differs from S3_ENDPOINT when the
# server reaches storage by a name clients cannot (e.g. compose: internal
# minio:9000 vs host localhost:9000). Leave unset for real S3/R2.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pintrail-media
S3_ACCESS_KEY_ID=pintrail
S3_SECRET_ACCESS_KEY=pintrail-dev-secret

# How long presigned upload/download URLs stay valid.
PRESIGN_TTL_SECS=900

# Enforced at completion; a presigned PUT cannot reject an oversized body
# while it streams. Default 100 MiB.
MAX_UPLOAD_BYTES=104857600
