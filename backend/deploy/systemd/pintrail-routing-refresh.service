# Rebuilds the Valhalla routing data from a fresh OpenStreetMap extract.
# Started by pintrail-routing-refresh.timer. Install: docs/DEPLOYMENT.md,
# "Routing". User= and the paths are set for the production host
# (pintrail.cs.umass.edu, user richards), like pintrail-autodeploy.service;
# change them only on a different host.
[Unit]
Description=Refresh PinTrail's walking-route data from OpenStreetMap
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=richards
WorkingDirectory=/home/richards/pintrail/backend
ExecStart=/home/richards/pintrail/backend/deploy/routing-refresh.sh
# Downloading and building Massachusetts takes tens of minutes.
TimeoutStartSec=3h
Nice=10
