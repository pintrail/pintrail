# Runs deploy/auto-deploy.sh once. Started by pintrail-autodeploy.timer.
# Install and enable: docs/DEPLOYMENT.md, "Automatic deploys".
#
# User= and the paths are set for the production host (pintrail.cs.umass.edu,
# user richards); change them only on a different host. The user must own
# the checkout and be in the docker group (not run docker through
# sudo, which drops the image tag the deploy passes to compose).
[Unit]
Description=Deploy PinTrail when main has moved and CI passed
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=richards
WorkingDirectory=/home/richards/pintrail/backend
ExecStart=/home/richards/pintrail/backend/deploy/auto-deploy.sh
# A first build compiles the whole Rust workspace; give it room.
TimeoutStartSec=45min
